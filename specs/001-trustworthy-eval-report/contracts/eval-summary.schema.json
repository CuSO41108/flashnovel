{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashnovel.local/contracts/eval-summary.schema.json",
  "title": "FlashNovel Evaluation Summary",
  "type": "object",
  "required": [
    "eval_version",
    "summary_schema_version",
    "created_at",
    "mode",
    "dataset_scope",
    "execution_scope",
    "by_system",
    "by_tag",
    "llm_calls",
    "unavailable_metrics",
    "results"
  ],
  "properties": {
    "eval_version": { "type": "string" },
    "summary_schema_version": { "const": "2.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["dry-run", "live"] },
    "dataset_scope": { "$ref": "#/$defs/datasetScope" },
    "execution_scope": { "$ref": "#/$defs/executionScope" },
    "by_system": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/metricGroup" }
    },
    "by_tag": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/metricGroup" }
      }
    },
    "llm_calls": {
      "type": "object",
      "required": ["attempted_count", "observed_count", "records"],
      "properties": {
        "attempted_count": { "type": "integer", "minimum": 0 },
        "observed_count": { "type": "integer", "minimum": 0 },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/llmCall" }
        }
      },
      "additionalProperties": true
    },
    "unavailable_metrics": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseSystemResult" }
    }
  },
  "$defs": {
    "datasetScope": {
      "type": "object",
      "required": ["dataset_path", "case_ids", "case_count", "target_chapters", "tag_counts"],
      "properties": {
        "dataset_path": { "type": "string" },
        "case_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "case_count": { "type": "integer", "minimum": 1 },
        "target_chapters": { "type": "integer", "minimum": 1 },
        "tag_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "executionScope": {
      "type": "object",
      "required": [
        "case_ids",
        "case_count",
        "target_chapters",
        "systems",
        "expected_result_count",
        "coverage_status",
        "coverage_reasons"
      ],
      "properties": {
        "case_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "case_count": { "type": "integer", "minimum": 1 },
        "target_chapters": { "type": "integer", "minimum": 1 },
        "systems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "expected_result_count": { "type": "integer", "minimum": 1 },
        "coverage_status": { "enum": ["complete", "partial"] },
        "coverage_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "metricGroup": {
      "type": "object",
      "required": ["result_count", "hard_metrics", "soft_metrics"],
      "properties": {
        "result_count": { "type": "integer", "minimum": 0 },
        "hard_metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metricResult" }
        },
        "soft_metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metricResult" }
        }
      },
      "additionalProperties": true
    },
    "metricResult": {
      "type": "object",
      "required": [
        "name",
        "status",
        "value",
        "denominator",
        "observed_count",
        "excluded_count",
        "source",
        "applicability",
        "limitations"
      ],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["complete", "incomplete", "unavailable"] },
        "value": { "type": ["number", "null"] },
        "numerator": { "type": ["number", "null"] },
        "denominator": { "type": "integer", "minimum": 0 },
        "observed_count": { "type": "integer", "minimum": 0 },
        "excluded_count": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" },
        "applicability": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "llmCall": {
      "type": "object",
      "required": [
        "call_id",
        "stage",
        "mode",
        "status",
        "latency_ms",
        "usage_status"
      ],
      "properties": {
        "call_id": { "type": "string" },
        "case_id": { "type": ["string", "null"] },
        "system": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "stage": { "type": "string" },
        "mode": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "status": { "enum": ["completed", "failed"] },
        "latency_ms": { "type": "number", "minimum": 0 },
        "usage_status": { "enum": ["complete", "incomplete", "unavailable"] },
        "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "error_type": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "caseSystemResult": {
      "type": "object",
      "required": [
        "case_id",
        "system",
        "status",
        "target_chapter_count",
        "generated_chapter_count",
        "chapter_complete"
      ],
      "properties": {
        "case_id": { "type": "string" },
        "system": { "type": "string" },
        "status": { "type": "string" },
        "target_chapter_count": { "type": "integer", "minimum": 1 },
        "generated_chapter_count": { "type": "integer", "minimum": 0 },
        "chapter_complete": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
